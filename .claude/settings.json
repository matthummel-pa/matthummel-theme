{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(composer install:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpcs:*)",
      "Bash(phpcs:*)",
      "Bash(python3 .github/scripts/wp-review:*)",
      "Bash(wp-review:*)",
      "Bash(studio status:*)",
      "Bash(studio start:*)",
      "Bash(studio wp acorn:*)",
      "Bash(studio wp cache flush:*)",
      "Bash(studio wp option get:*)",
      "Bash(studio wp post list:*)",
      "Bash(studio wp theme list:*)",
      "Bash(studio wp plugin list:*)",
      "Bash(wp acorn:*)",
      "Bash(rg:*)",
      "WebFetch(domain:developer.wordpress.org)",
      "WebFetch(domain:make.wordpress.org)",
      "WebFetch(domain:roots.io)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:vite.dev)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(studio wp:*)",
      "Bash(wp:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./wp-config.php)",
      "Read(./.deploy-keys/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(studio delete:*)",
      "Bash(studio preview delete:*)",
      "Bash(wp db reset:*)",
      "Bash(wp db drop:*)",
      "Bash(studio wp db reset:*)",
      "Bash(studio wp db drop:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
