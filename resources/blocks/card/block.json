{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matthummel/card",
  "title": "Card",
  "category": "matthummel",
  "icon": "index-card",
  "description": "One card: icon, heading, and text.",
  "textdomain": "sage",
  "attributes": {
    "icon": {
      "type": "string",
      "default": ""
    },
    "number": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": false,
    "className": true,
    "reusable": false
  },
  "parent": [
    "matthummel/cards"
  ]
}
