{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matthummel/featured-projects",
  "title": "Featured projects",
  "category": "matthummel",
  "icon": "portfolio",
  "description": "Project cards picked from the Projects list. The cards update when projects change.",
  "keywords": [
    "projects",
    "work",
    "portfolio"
  ],
  "textdomain": "sage",
  "attributes": {
    "count": {
      "type": "number",
      "default": 3
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "linkText": {
      "type": "string",
      "default": "Browse all"
    }
  },
  "mhControls": {
    "count": {
      "label": "Projects to show",
      "min": 1,
      "max": 9
    },
    "showCount": {
      "label": "Show how many projects there are"
    },
    "linkText": {
      "label": "Link to all projects",
      "help": "Leave empty to hide the link."
    }
  },
  "supports": {
    "html": false,
    "align": false,
    "className": true,
    "reusable": false
  }
}
