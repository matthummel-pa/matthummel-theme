{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matthummel/latest-themes",
  "title": "Latest themes",
  "category": "matthummel",
  "icon": "layout",
  "description": "The newest themes from the shop as cards. They update when products change.",
  "keywords": [
    "themes",
    "shop",
    "products"
  ],
  "textdomain": "sage",
  "attributes": {
    "count": {
      "type": "number",
      "default": 3
    },
    "linkText": {
      "type": "string",
      "default": "Browse all themes"
    }
  },
  "mhControls": {
    "count": {
      "label": "Themes to show",
      "min": 1,
      "max": 6
    },
    "linkText": {
      "label": "Link to all themes",
      "help": "Leave empty to hide the link."
    }
  },
  "supports": {
    "html": false,
    "align": false,
    "className": true,
    "reusable": false
  }
}
