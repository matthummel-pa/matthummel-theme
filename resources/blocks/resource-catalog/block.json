{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "matthummel/resource-catalog",
  "title": "Resource links",
  "category": "matthummel",
  "icon": "admin-links",
  "description": "Link cards from one group of the Resources catalog. Affiliate links are labeled and marked as sponsored.",
  "keywords": [
    "resources",
    "tools",
    "affiliate"
  ],
  "textdomain": "sage",
  "attributes": {
    "section": {
      "type": "string",
      "enum": [
        "starters",
        "themes",
        "tools"
      ],
      "default": "starters"
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "limit": {
      "type": "number",
      "default": 0
    }
  },
  "mhControls": {
    "section": {
      "label": "Which group",
      "options": {
        "starters": "Free WordPress starters",
        "themes": "Themes for sale",
        "tools": "Tools I recommend"
      }
    },
    "showCount": {
      "label": "Show how many links there are"
    },
    "limit": {
      "label": "Links to show up front",
      "min": 0,
      "max": 24,
      "help": "The rest go behind a Show more button. 0 shows them all."
    }
  },
  "supports": {
    "html": false,
    "align": false,
    "className": true,
    "reusable": false
  }
}
